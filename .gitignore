# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# Node / TypeScript artifacts
node_modules/
dist/
coverage/

# Python / ESPHome generated caches
__pycache__/
*.pyc

# PlatformIO / ESPHome build caches
.platformio/
.esphome-test/

# Isolated verification tools, reports and deployment bundles
.venv*/
.cache/
.audit/
.b/
*.log
**/.esphome/
**/secrets*.yaml
.env
.env.*
!.env.example
